# i3 configuration for rlOS
#
# WHY THIS FILE EXISTS AND WHY IT IS SHIPPED IN THE IMAGE
# ------------------------------------------------------
# i3 refuses to start without a config: get_config_path() (src/config.c:235)
# dies with "Unable to find the configuration file" if none of
# $XDG_CONFIG_HOME/i3/config, ~/.i3/config, $XDG_CONFIG_DIRS/i3/config or
# SYSCONFDIR/i3/config exists. It looks those up relative to $HOME, which is a
# moving target in a live image, so init.c passes -c with an absolute path
# instead and this file does not depend on the environment at all.
#
# $mod is the Super key. That is i3's own default and it is what leaves the
# other modifiers free for the terminal and for Alt-based bindings inside apps.
set $mod Mod4

# ---------------------------------------------------------------- fonts
# The guest ships only JetBrainsMono Nerd Font Mono, in four faces (regular,
# bold, italic, bold-italic), so a font family that cannot resolve leaves the bar
# drawing with a core X font or nothing. i3bar matches families in order and takes
# the first that has every glyph it needs.
font pango:JetBrainsMono Nerd Font Mono 11

# ---------------------------------------------------------------- workspaces
# Plain numbers, no names.
#
# These exist only to pin the count and the order, and `output primary` keeps
# every workspace on the laptop panel rather than spreading them over whatever
# outputs happen to be attached. i3 starts on the FIRST workspace listed here
# (src/workspace.c, "Find first workspace"), so this block is also what makes the
# session come up on 1 rather than wherever it was left - which is why there is
# no explicit "startup workspace" directive: there is no such config keyword, and
# i3 has no --workspace flag either. Ordering is the mechanism.
#
# The previous "1 web, 2 term, 3 code..." names were removed deliberately. They
# implied a workflow (a chat workspace, a docs workspace) that this system does
# not set up - no mail client, no documents workspace worth naming - so the names
# described an intention rather than the machine. The bar shows the number, which
# is all i3 has ever needed to show.
workspace "1" output primary
workspace "2" output primary
workspace "3" output primary
workspace "4" output primary
workspace "5" output primary
workspace "6" output primary
workspace "7" output primary
workspace "8" output primary
workspace "9" output primary

# ---------------------------------------------------------------- bar
# i3bar is a separate binary that this execs.
#
# status_command runs a shell script that prints i3status-format JSON on stdout,
# one block per line; i3bar re-reads it every time a new line arrives. That is
# the whole interface, and it does NOT require the i3status binary: i3bar parses
# the JSON itself (i3bar/src/child.c execs the command through /bin/sh, and
# strings on the built binary shows _PATH_BSHELL=/bin/sh, which busybox ash
# satisfies). The earlier comment here claimed i3status was missing and therefore
# a clock was impossible - that was wrong. i3status is only a producer of this
# format; any script can produce it. Verified accepted keys in that parser:
# full_text short_text color background border markup align separator.
#
# rlos-clock is three lines of shell. What it cannot do is know the timezone: the
# image ships no zoneinfo database, so `date` parses TZ as a POSIX string rather
# than a zone name and Europe/Berlin silently degrades to +0000. rlos-clock reads
# TZ from the environment, so setting TZ=Europe/Berlin in the shell is all it
# takes once zoneinfo is present.
bar {
        position top
        status_command /usr/bin/rlos-clock
        font pango:JetBrainsMono Nerd Font Mono 11
        colors {
                # Three deliberately different darknesses, so the desktop reads as
                # layers rather than as one flat dark field:
                #
                #   bar     #16161e  darkest
                #   desktop #1a1b26  set by setrootbg, one step lighter than the bar
                #   window  #24273b  lightest - the terminal, see /usr/etc/mlterm/main
                #
                # The terminal is the LIGHTEST of the three on purpose. A window
                # that is darker than its own bar disappears into the desktop, and
                # a window the same shade as the desktop has no edge at all. This
                # is the opposite of the old arrangement, where the terminal was
                # #1b1e28 and the desktop was #313244 - lighter than the window -
                # so the terminal read as a hole rather than as a surface.
                background #16161e
                statusline #16161e
                separator  #414868
                # Focused is the one saturated colour on the bar. Everything else
                # is a neutral, so "which workspace am I on" is answered at a
                # glance without reading the title. active_workspace is the same
                # slot for a workspace that has windows but is not focused, and it
                # is a barely-there grey: present enough to tell you the workspace
                # is occupied, quiet enough that only the focused one shouts.
                focused_workspace  #7dcfff   #16161e
                active_workspace   #292e42   #a6adc8
                inactive_workspace #16161e   #565f89
                urgent_workspace   #f38ba8   #16161e
                binding_mode       #7dcfff   #16161e
        }
}

# ---------------------------------------------------------------- keybindings
# The one people need first, and the reason this file is here rather than
# leaving i3 to its compiled-in defaults.
#
# $mod+Return runs the terminal. i3's default is i3-sensible-terminal, which
# probes a long list of names and is not in the image, so it is named directly.
set $term mlterm
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $term

# The file manager, on plain Super+f.
#
# Super+f was free and still is for fullscreen, which is on Super+Shift+f - the
# build's help-sheet gate checks that the keysym `f` is bound to `fullscreen`
# under SOME modifier chain, and Shift+ satisfies it, so binding `f` a second
# time for a different action does not collide.
#
# $HOME is NOT interpolated by i3 - only variables introduced with `set` are - so
# the path is spelled as an i3 variable rather than relying on the environment
# leaking into exec. xfiles with no argument opens $HOME anyway, but passing it
# makes the start directory explicit rather than dependent on xfiles' own default.
set $files xfiles
bindsym $mod+f exec $files

# The application menu, on Super+d. That is d for "drawer", and it was free:
# nothing in this file or in i3's defaults claims plain `d` under a modifier.
#
# The command is the whole menu, not a bare `xmenu`. xmenu knows nothing about
# this image - it reads a specification on stdin and prints the chosen entry, so
# something has to generate that specification and then run the result.
# ~/scripts/xmenu.sh does both: it writes a menu of the programs this image
# actually has, which is why it has to be a script rather than a config line.
set $menu ~/scripts/xmenu.sh
bindsym $mod+d exec $menu

# NO `assign [class="(?i)^mlterm$"] 1` any more.
#
# That line existed to force the terminal onto workspace 1, on the theory that
# i3's own choice of first workspace was not pinned down. It was: i3 starts on the
# first workspace in this file (src/workspace.c, "Find first workspace"), and
# this block lists "1" first. So the assignment was redundant at boot AND harmful
# afterwards - it dragged every new terminal back to workspace 1 no matter which
# workspace you were actually working in. Now the terminal opens wherever you
# are, which is the behaviour that matches the key you pressed.
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e restart
bindsym $mod+Shift+c reload
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+Shift+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+Shift+d layout toggle split
bindsym $mod+space floating toggle
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
# Super+Shift+1..9 MOVES the focused window to that workspace instead of
# switching to it. Deliberately not Super+Alt+1: i3's own default for
# move-to-workspace is Mod+Shift+digit, so this shadows nothing it already does,
# and it is the pair a window-manager user reaches for first.
bindsym $mod+Shift+1 workspace 1
bindsym $mod+Shift+2 workspace 2
bindsym $mod+Shift+3 workspace 3
bindsym $mod+Shift+4 workspace 4
bindsym $mod+Shift+5 workspace 5
bindsym $mod+Shift+6 workspace 6
bindsym $mod+Shift+7 workspace 7
bindsym $mod+Shift+8 workspace 8
bindsym $mod+Shift+9 workspace 9
bindsym $mod+Left  workspace previous
bindsym $mod+Right workspace next

# --------------------------------------------------------------- help
# The cheat sheet. /bin/help is an rl program (rl_programs/help.rl) shipped as
# source under /home/user/programs/rl, so it is run through rl rather than
# executed directly.
bindsym $mod+Shift+question exec $term -e /bin/rl run /home/user/programs/rl/help.rl

# --------------------------------------------------------------- misc
# focus_follows_mouse is off: this is a touchpad machine and following the
# pointer makes windows steal focus while you are reading one.
focus_follows_mouse no
mouse_warping output
default_border pixel 1
default_floating_border pixel 1
floating_modifier $mod
# Borders stay off, and that is a consequence of the palette above rather than an
# inherited default. The desktop is #1a1b26 and the terminal is #24273b, so every
# window is LIGHTER than the surface behind it and its edge is already visible
# without help. Under the old scheme - #313244 desktop behind a #1b1e28 terminal -
# a borderless terminal was darker than its background and had no edge at all,
# which is what that colour choice was originally working around. Flip the
# layering and the workaround is what has to go, not the palette.

# Re-apply the wallpaper AFTER i3 has started. init.c already runs setrootbg
# once (init.c:2013) but it does so BEFORE the window manager, and i3 paints its
# own background over the root window during startup - so that run's work is
# erased before anything is drawn and the desktop comes up flat. This second exec
# happens after i3 has finished painting, so it wins.
#
# Same reasoning as the setrootcursor below, and the same fix: i3 overwrites
# root-window state at startup with libxcb calls that do not consult our theme,
# so the only way to win is to apply it afterwards. Running it twice is
# harmless - setrootbg just sets a background pixmap and ESETROOT_PMAP_ID.
#
# --no-startup-id keeps it out of the layout tree; it is a one-shot, not a
# managed window, and without this i3 would hold a placeholder for it forever.
exec --no-startup-id /usr/bin/setrootbg

# Re-apply the themed root cursor AFTER i3 has overwritten it. At startup i3
# sets the root cursor to its own pointer via libxcb-cursor, which does not read
# XCURSOR_THEME and falls back to a black block; this exec runs after that, so
# it wins and the pointer is themed. See init.c (setrootcursor comment) and
# build_x11.sh (the `default` icon-theme alias) for the two halves of this fix.
exec --no-startup-id /usr/bin/setrootcursor
